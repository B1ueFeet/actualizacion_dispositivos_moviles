<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.AntiDesperdicio" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/app_primary</item>
        <item name="colorPrimaryVariant">@color/app_primary_dark</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorSecondary">@color/app_accent</item>
        <item name="android:colorAccent">@color/app_accent</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="materialButtonStyle">@style/Widget.AntiDesperdicio.Button</item>
    </style>

    <style name="Widget.AntiDesperdicio.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/app_primary</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="cornerRadius">14dp</item>
    </style>

</resources>
